#!/bin/sh
# Block commits that contain Stripe secret/restricted keys or webhook secrets.
if git diff --cached -U0 --diff-filter=ACM | grep -E '^\+' | grep -Eq '(sk|rk)_(live|test)_[0-9A-Za-z]{10,}|whsec_[0-9A-Za-z]{10,}'; then
  echo "pre-commit: Stripe key or webhook secret found in staged changes. Remove it and use .env / a secrets vault." >&2
  exit 1
fi
