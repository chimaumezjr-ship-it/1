# Copy to .env (never commit .env). In production, load these from your
# hosting platform's secrets vault instead.

# Prefer a restricted key (rk_test_... / rk_live_...) with only:
#   Customers: write, Checkout Sessions: write, Customer portal: write,
#   Subscriptions: read, Prices: read, Products: read,
#   Invoices: write, Invoice items: write
# The seed script additionally needs Products: write and Prices: write —
# use a separate key for it.
STRIPE_SECRET_KEY=

# From `stripe listen` (local) or Dashboard > Developers > Webhooks (deployed).
STRIPE_WEBHOOK_SECRET=

# Leave false until you have an active UK VAT registration in
# Dashboard > Tax > Registrations. Otherwise Stripe silently collects £0 tax.
STRIPE_AUTOMATIC_TAX=false

# Bearer token for staff-only endpoints (POST /api/admin/invoices).
# Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=

PORT=4242
BASE_URL=http://localhost:4242
